VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server-only values: Vercel Settings > Environment Variables or local .env.local.
# Never prefix secrets with VITE_ or commit actual credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Challenge generation only; does not change syllabus/teach-back models.
GEMINI_CHALLENGE_MODEL=gemini-3.8-flash
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Random secret of at least 32 characters.
TEACHING_SIGNING_SECRET=

# Optional tutor read-aloud (server only).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional Auth0 login. All three VITE values enable it. Public, not secrets.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
# Server values must match their VITE counterparts. No Auth0 client secret needed.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
