{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/generate-challenge-gemini.js": {
      "maxDuration": 60
    },
    "api/save-challenge.js": {
      "maxDuration": 60
    },
    "api/parse-syllabus.js": {
      "maxDuration": 60
    },
    "api/verify-teaching.js": {
      "maxDuration": 60
    },
    "api/speak.js": {
      "maxDuration": 30
    },
    "api/room-study.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|assets/|favicon.svg|challenge-demo.html).*)",
      "destination": "/index.html"
    }
  ]
}
